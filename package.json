{
  "name": "cr-league-app",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "start": "npm run build && electron .",
    "package:dir": "npm run build && node scripts/copy-node.js && electron-builder --dir --config.npmRebuild=false",
    "package:win": "npm run build && node scripts/copy-node.js && electron-builder --win nsis",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.crleaguemanager.desktop",
    "productName": "CR League Manager",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": ["backend/**"],
    "directories": { "output": "release" },
    "files": [
      "main.js",
      "preload.js",
      "frontend/dist/**/*",
      "backend/dist/**/*",
      "backend/package.json",
      "backend/node_modules/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/.cache/**/*",
      "!frontend/node_modules/**/*",
      "!backend/node_modules/typescript/**/*",
      "!backend/node_modules/tsx/**/*",
      "!backend/node_modules/ts-node-dev/**/*",
      "!backend/node_modules/@types/**/*"
    ],
    "extraResources": [{ "from": "build-resources/node", "to": "node" }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CR League Manager"
    }
  }
}
